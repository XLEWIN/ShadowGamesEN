# ── Shadow Game Bot (merged) environment ─────────────────────
# Copy this file to `.env` (in this folder or inside shadow_game_bot/)
# and fill in the values.

# REQUIRED — Telegram bot token (same token/env style as ShadowgameBot)
BOT_TOKEN=

# Owner (bot admin) Telegram user id — enables /stats /gban /ungban /resetdata
# and the WordSeek owner commands (/ban /broadcast /track /captcha /transfer ...)
OWNER_ID=0

# Log group for bot events + anti-cheat alerts (ShadowgameBot default kept)
LOG_GROUP_ID=-1003845687680

# SQLite database file base name (file will be <name>.db next to run.py)
DATABASE_NAME=shadow_game

# Seconds of inactivity before a Shadow Word Guess game auto-ends
INACTIVITY_TIMEOUT=300

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── WordSeek (optional, ported features) ──────────────────────

# Timezone for Daily WordSeek (new puzzle at 06:00 in this zone)
TIME_ZONE=Asia/Calcutta

# Seed for the deterministic daily word shuffle.
# Change this to pick a different daily-word rotation.
DAILY_WORDLE_SECRET=shadow-wordseek-default-secret

# First day of the daily-word rotation (YYYY-MM-DD)
DAILY_WORDLE_START_DATE=2025-01-01

# Optional Gemini API key(s) for daily-word meanings (space OR comma separated).
# Leave empty — daily WordSeek still works, just without meanings/phonetics.
GEMINI_API_KEYS=

# Optional separate logs channel for anti-cheat alerts.
# Defaults to LOG_GROUP_ID when empty.
LOGS_CHANNEL=
