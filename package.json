{
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "status": "tgcloud status",
    "push": "tgcloud push",
    "migrate": "tgcloud migrate",
    "run": "tgcloud run",
    "webhook": "tgcloud webhook",
    "test": "node scripts/test.js",
    "check": "node scripts/check.js && node scripts/test.js",
    "verify": "npm run check && npm run build:web",
    "build:web": "npm --prefix webapp-src run build",
    "deploy": "npm run build:web && tgcloud push"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  }
}
