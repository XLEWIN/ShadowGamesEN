{
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "status": "tgcloud status",
    "push": "tgcloud push",
    "migrate": "tgcloud migrate",
    "run": "tgcloud run",
    "webhook": "tgcloud webhook",
    "test": "node --test tests_js/*.test.js",
    "check": "node --check tgcloud/handlers/message.js && node --test tests_js/*.test.js",
    "build:web": "npm --prefix webapp-src run build",
    "deploy": "npm run build:web && tgcloud push"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  }
}
